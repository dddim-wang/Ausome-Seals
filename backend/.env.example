CONTACT_TO_EMAIL=support@ausomeseals.com

# Recommended for Railway: Resend uses HTTPS instead of SMTP ports.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Ausome Seals <onboarding@resend.dev>

# Optional SMTP fallback for hosts that allow outbound SMTP.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# SMTP_USERNAME=your-sender@gmail.com
# SMTP_PASSWORD=your-gmail-app-password
# SMTP_FROM_EMAIL=your-sender@gmail.com

# Optional: lock API access to the deployed frontend domain.
FRONTEND_ORIGIN=http://localhost:5173

# Contact form protection. Use Redis storage when running multiple backend instances.
MAX_API_REQUEST_BYTES=32768
RATELIMIT_STORAGE_URI=memory://

# AI chat provider. Use stub for offline development or deepseek in production.
AI_PROVIDER=stub
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_RETRY_BASE_SECONDS=0.5
DEEPSEEK_RETRY_MAX_SECONDS=5

# Local RAG. The service searches backend/knowledge, project/knowledge,
# then backend/tests/knowledge. The committed index is validated by content hash.
RAG_ENABLED=true
RAG_KNOWLEDGE_DIR=knowledge
RAG_RESULT_LIMIT=5
RAG_PRELOAD=true
RAG_BUILD_MISSING=false

# Multilingual semantic retrieval. Run `python build_embedding_index.py` after
# changing knowledge files. Runtime falls back to keyword search if unavailable.
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_PATH=.cache/rag-vectors.json
EMBEDDING_MODEL_CACHE_DIR=.cache/fastembed
EMBEDDING_THREADS=2
EMBEDDING_BUILD_MISSING=false
